# Address to listen on. On the Pi set this to its LAN IP (e.g. 192.168.1.111)
# so the app is never reachable on other interfaces. Never 0.0.0.0 on the Pi.
HOST=127.0.0.1
PORT=3001

# PIN for the admin page (/admin.html). Required to use admin.
ADMIN_PIN=changeme

# Path to the Claude Code CLI binary. Must already be logged in with your
# subscription (run `claude` once interactively). ANTHROPIC_API_KEY must NOT be set.
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet

TZ=Europe/Ljubljana
